# Copy to .env for local development; set the same variables in Vercel → Settings → Environment Variables.
# Never commit real values.

# Demo form endpoint. Default (unset): /api/lead, the Vercel function in this repo.
# Set to "stub" to log leads in the browser console instead of sending them.
PUBLIC_LEAD_ENDPOINT=

# Neon Postgres connection string (the `leads` table is created on first request).
DATABASE_URL=

# Resend API key and where new-lead notifications go (comma-separate several addresses).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Optional: sender address on a domain verified in Resend. Defaults to onboarding@resend.dev (testing only).
LEAD_FROM_EMAIL=

# Optional but recommended: random secret mixed into the IP hash so stored hashes can't be reversed.
IP_HASH_SALT=

# Optional: create each lead in Zoho CRM (India data centre). All three must be set to enable.
# See README → "Zoho CRM (optional)".
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
