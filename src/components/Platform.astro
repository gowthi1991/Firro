---
import { platform } from '../content/site';
import SectionHead from './SectionHead.astro';
import AppPos from './illustrations/AppPos.astro';
import AppAdmin from './illustrations/AppAdmin.astro';
import AppCustomer from './illustrations/AppCustomer.astro';
import AppDelivery from './illustrations/AppDelivery.astro';
import TrendChart from './illustrations/TrendChart.astro';

const ills = [AppPos, AppAdmin, AppCustomer, AppDelivery];
const { hood } = platform;
const { subscriptions: subs, warnings, costing, gst } = hood;
---

<section id="platform" class="section bt platform" aria-labelledby="platform-title">
  <div class="container">
    <div class="rv head">
      <SectionHead
        id="platform-title"
        label={platform.label}
        heading={platform.heading}
        maxCh={13}
      />
      <p class="lead">{platform.lead}</p>
    </div>
    <div class="apps">
      {platform.apps.map((a, i) => {
        const Ill = ills[i]!;
        return (
          <div class:list={['glass tile rv app', i > 0 && `s${i + 1}`]}>
            <div class="appill">
              <Ill width="200" height="140" aria-hidden="true" />
            </div>
            <span class="micro px">{a.where}</span>
            <h3 class="disp px">{a.name}</h3>
            <p class="soft px">{a.body}</p>
          </div>
        );
      })}
    </div>

    <div class="rv hoodhead">
      <span class="micro gold">{hood.label}</span>
      <h3 class="disp hoodtitle">
        {hood.heading.title} <em class="acc">{hood.heading.accent}</em>
      </h3>
    </div>
    <div class="wseq bento" data-seq="hood">
      <div class="glass rv b subs">
        <span class="micro m11">{subs.label}</span>
        <h3 class="disp btitle t28">{subs.title}</h3>
        <p class="soft bbody" style="max-width:40ch">
          {subs.body}
        </p>
        <div class="subsfill">
          <div class="ringwrap">
            <div class="lockring" style="--p:62" data-countdown-ring>
              <div class="ringinner">
                <span class="micro ringlabel">{subs.ringLabel}</span>
                <span class="lockclock mono" data-countdown role="timer" aria-live="off">
                  {subs.ringDefault}
                </span>
                <span class="mono ringat">{subs.ringAt}</span>
              </div>
            </div>
          </div>
          <div class="cutoffs">
            {subs.cutoffs.map((c) => (
              <div class="cutoff">
                <p class="num cval">{c.value}</p>
                <p class="clabel">{c.label}</p>
              </div>
            ))}
          </div>
          <p class="sample exnote">{subs.note}</p>
        </div>
      </div>

      <div class="glass rv s2 b warn">
        <div class="wtop">
          <span class="micro m11">{warnings.label}</span>
          <span class="chip status">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <polyline points="12 7 12 12 15 14"></polyline>
            </svg>
            {warnings.status}
          </span>
        </div>
        <h3 class="disp btitle">{warnings.title}</h3>
        <p class="soft bbody" style="max-width:44ch">
          {warnings.body}
        </p>
        <div class="chart">
          <TrendChart class="trend" width="100%" height="150" aria-hidden="true" />
          <div class="wflag">{warnings.flag}</div>
          <div class="mono weeks">
            <span>{warnings.from}</span>
            <span>{warnings.to}</span>
          </div>
        </div>
      </div>

      <div class="glass rv s3 b cost">
        <span class="micro m11">{costing.label}</span>
        <h3 class="disp btitle">{costing.title}</h3>
        <p class="soft bbody">{costing.body}</p>
        <div class="foot">
          <div class="pct">
            <span class="num pval">{costing.value}</span>
            <span class="punit">{costing.unit}</span>
          </div>
          <div class="split" aria-hidden="true">
            <div class="wbar" style="width:31%;background:#2E6B47"></div>
            <div class="wbar w2" style="width:69%;background:#9DBFA5"></div>
          </div>
          <div class="legend">
            <span>{costing.left}</span>
            <span>{costing.right}</span>
          </div>
        </div>
      </div>

      <div class="glass rv s4 b gst">
        <span class="micro m11">{gst.label}</span>
        <h3 class="disp btitle">{gst.title}</h3>
        <p class="soft bbody gbody">{gst.body}</p>
        <div class="foot">
          <p class="mono gpre">{gst.prefix}</p>
          <p class="mono gnum">{gst.number}</p>
          <div class="taxes">
            {gst.taxes.map((t) => (
              <span class="tax">
                {t.name} <span class="num">{t.rate}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
    <p class="sample bsample">{hood.sample}</p>
  </div>
</section>

<style>
  .platform {
    padding-bottom: 64px;
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 48px;
  }
  .lead {
    max-width: 560px;
  }
  .apps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .app {
    padding: 14px 14px 28px;
    gap: 12px;
  }
  .appill {
    height: 190px;
    border-radius: var(--r-lg);
    background-color: var(--surface-warm);
    background-image: radial-gradient(#e3d8be 1.3px, transparent 1.3px);
    background-size: 20px 20px;
    border: 1px solid rgba(201, 160, 70, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .px {
    padding: 0 12px;
  }
  .app h3 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .app p {
    font-size: 14px;
    line-height: 1.55;
  }

  .hoodhead {
    margin-top: 96px;
    margin-bottom: 40px;
  }
  .hoodtitle {
    font-size: var(--h3-hood);
    line-height: 1;
    max-width: 18ch;
    margin-top: 12px;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 16px;
  }
  .b {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .m11 {
    font-size: 11px;
  }
  .btitle {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .btitle.t28 {
    font-size: 28px;
  }
  .bbody {
    font-size: 15px;
    line-height: 1.6;
  }

  /* subscriptions + countdown ring */
  .subs {
    grid-column: span 5;
    grid-row: span 2;
  }
  .subsfill {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }
  .ringwrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 0 8px;
  }
  .lockring {
    width: 290px;
    height: 290px;
    border-radius: 50%;
    background: conic-gradient(var(--forest-mid) calc(var(--p) * 1%), #eae2d0 0);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 18px 50px -14px rgba(201, 160, 70, 0.55);
    transition: background 600ms linear;
  }
  .ringinner {
    width: 224px;
    height: 224px;
    border-radius: 50%;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .ringlabel {
    font-size: 9.5px;
  }
  .lockclock {
    font-size: 38px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .ringat {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .cutoffs {
    display: flex;
    gap: 10px;
  }
  .cutoff {
    flex: 1;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .cval {
    font-size: 22px;
    line-height: 1;
  }
  .clabel {
    font-size: 13px;
    color: var(--muted);
    margin-top: 6px;
  }
  .exnote {
    margin-top: 4px;
  }

  /* early warnings */
  .warn {
    grid-column: span 7;
    position: relative;
    overflow: hidden;
  }
  .wtop {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .status {
    background: var(--amber-bg);
    color: var(--amber-text);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .chart {
    position: relative;
    margin-top: 6px;
  }
  .chart :global(.trend) {
    display: block;
    overflow: visible;
  }
  .wflag {
    position: absolute;
    right: 34px;
    top: -8px;
    padding: 8px 12px;
    border-radius: 12px;
    background: var(--amber-bg);
    border: 1px solid rgba(245, 158, 11, 0.3);
    font-size: 13px;
    font-weight: 700;
    color: var(--amber-text);
  }
  .weeks {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--muted);
    margin-top: 6px;
  }

  /* recipe costing */
  .cost {
    grid-column: span 4;
  }
  .foot {
    margin-top: auto;
    padding-top: 14px;
  }
  .pct {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .pval {
    font-size: 64px;
    line-height: 1;
    color: var(--heritage);
  }
  .punit {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  .split {
    display: flex;
    height: 10px;
    border-radius: var(--r-pill);
    overflow: hidden;
    margin-top: 14px;
    background: #eae2d0;
  }
  .wbar {
    transform-origin: left;
  }
  .w2 {
    opacity: 0.55;
  }
  .legend {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
    margin-top: 8px;
  }

  /* GST */
  .gst {
    grid-column: span 3;
  }
  .gbody {
    font-size: 14px;
    line-height: 1.55;
  }
  .gpre {
    font-size: 12px;
    color: var(--muted);
  }
  .gnum {
    font-size: 40px;
    line-height: 1.05;
    font-weight: 600;
    color: var(--heritage);
    letter-spacing: -0.02em;
  }
  .taxes {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .tax {
    padding: 6px 10px;
    border-radius: var(--r-sm);
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: 12px;
    font-weight: 700;
  }
  .bsample {
    margin-top: 14px;
    text-align: right;
  }

  /* one-time sequence: trend draws, flag pops, cost bars fill */
  .play .wflag {
    animation: dishPop 420ms var(--ease-spring) 1700ms both;
  }
  .play .wbar {
    animation: nfill 800ms var(--ease-out) 600ms both;
  }
  .play .wbar.w2 {
    animation-delay: 200ms; /* reference: inline delay on the second bar overrides the 600ms */
  }

  @media (max-width: 1279px) {
    .b {
      padding: 28px;
    }
    .lockring {
      width: 260px;
      height: 260px;
    }
    .ringinner {
      width: 200px;
      height: 200px;
    }
    .lockclock {
      font-size: 34px;
    }
    .pval {
      font-size: 56px;
    }
    .gnum {
      font-size: 34px;
    }
  }
  @media (max-width: 1023px) {
    .apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hoodhead {
      margin-top: 80px;
    }
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
    }
    .warn {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .subs {
      grid-column: 1;
      grid-row: 2 / span 2;
    }
    .cost {
      grid-column: 2;
      grid-row: 2;
    }
    .gst {
      grid-column: 2;
      grid-row: 3;
    }
    .lockring {
      width: 240px;
      height: 240px;
    }
    .ringinner {
      width: 186px;
      height: 186px;
    }
    .lockclock {
      font-size: 31px;
    }
  }
  @media (max-width: 767px) {
    .head {
      margin-bottom: 32px;
    }
    .apps {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .app {
      padding: 12px 12px 24px;
    }
    .appill {
      height: 160px;
    }
    .hoodhead {
      margin-top: 64px;
      margin-bottom: 28px;
    }
    .bento {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .warn,
    .subs,
    .cost,
    .gst {
      grid-column: 1;
      grid-row: auto;
    }
    .b {
      padding: 24px 20px;
    }
    .cutoff {
      padding: 12px;
    }
    .chart :global(.trend) {
      height: auto;
      aspect-ratio: 620 / 150;
    }
    .wflag {
      position: relative;
      right: auto;
      top: auto;
      align-self: flex-end;
      display: inline-block;
      margin: 0 0 8px auto;
      width: fit-content;
      font-size: 12px;
    }
    .chart {
      display: flex;
      flex-direction: column;
    }
    .chart :global(.trend) {
      order: 1;
    }
    .weeks {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .play .wflag,
    .play .wbar {
      animation: none;
    }
    .lockring {
      transition: none;
    }
  }
</style>
