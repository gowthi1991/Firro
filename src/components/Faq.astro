---
import { faq } from '../content/site';
import { WHATSAPP_URL } from '../config/site';
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="container grid">
    <div class="rv intro">
      <span class="micro">{faq.label}</span>
      <h2 id="faq-title" class="h2 md">
        {faq.heading.title} <em class="acc">{faq.heading.accent}</em>
      </h2>
      <p class="lead">
        {faq.leadBefore}{' '}
        <a href={WHATSAPP_URL} data-event="whatsapp_click">
          {faq.leadLink}
        </a>
        .
      </p>
    </div>
    <div class="rv list">
      {faq.items.map((it, i) => (
        <details open={i === 0}>
          <summary>
            {it.q}
            <svg
              class="pm"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#1F5C3A"
              stroke-width="1.75"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
          </summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 96px var(--gutter) var(--section-y);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }
  .intro {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .lead a {
    font-weight: 800;
  }
  .list {
    grid-column: 7 / span 6;
  }
  details {
    border-top: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .pm {
    transition: transform var(--dur-fast) var(--ease-out);
    flex: none;
  }
  details[open] .pm {
    transform: rotate(45deg);
  }
  details p {
    padding: 0 0 24px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
    max-width: 620px;
  }
  details[open] p {
    animation: rise var(--dur-fast) var(--ease-out) both;
  }
  @media (max-width: 1023px) {
    .faq {
      padding-top: var(--section-y);
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 36px;
    }
    .intro,
    .list {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    summary {
      font-size: 19px;
      padding: 20px 0;
      gap: 16px;
    }
    details p {
      padding-bottom: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm {
      transition: none;
    }
    details[open] p {
      animation: none;
    }
  }
</style>
