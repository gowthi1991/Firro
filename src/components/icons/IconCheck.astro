---
// Check mark used across the reference (trust row, checks, chips).
interface Props {
  size?: number;
  strokeWidth?: number;
}
const { size = 18, strokeWidth = 1.75 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <polyline points="5 12 10 17 19 7"></polyline>
</svg>
