---
import { how } from '../content/site';
---

<section id="how" class="forest section" aria-labelledby="how-title">
  <div class="container">
    <div class="rv head">
      <div>
        <span class="micro">{how.label}</span>
        <h2 id="how-title" class="h2">
          {how.heading.title} <em class="gold-acc">{how.heading.accent}</em>
        </h2>
      </div>
      <p class="lead">{how.lead}</p>
    </div>
    <div class="hseq" data-seq="how">
      <div class="htrack" aria-hidden="true">
        <div class="hfill"></div>
        <div class="hmark"></div>
      </div>
      <ol>
        {how.steps.map((s, i) => (
          <li class:list={['glass tile hcard rv', i > 0 && `s${i + 1}`]} style={`--d:${s.delay}ms`}>
            <span class="hnode" aria-hidden="true" />
            <span class="mono htime">{s.time}</span>
            <h3 class="disp">{s.title}</h3>
            <p class="soft">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .forest {
    background:
      radial-gradient(700px 500px at 85% 10%, rgba(217, 180, 90, 0.14), transparent 60%),
      linear-gradient(rgba(240, 215, 138, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 215, 138, 0.05) 1px, transparent 1px),
      linear-gradient(160deg, var(--forest), var(--forest-deep));
    background-size:
      auto,
      64px 64px,
      64px 64px,
      auto;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--line);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 56px;
  }
  .micro {
    color: var(--gold-soft);
  }
  .h2 {
    max-width: 12ch;
    margin-top: 14px;
    color: var(--cream-on-dark);
  }
  .gold-acc {
    font-style: italic;
    font-weight: 600;
    color: var(--gold-light);
  }
  .lead {
    max-width: 420px;
    color: var(--text-on-dark);
  }

  .hseq {
    position: relative;
  }
  ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    position: relative;
  }
  .hcard {
    gap: 14px;
    background: rgba(255, 253, 245, 0.05);
    border-color: rgba(240, 215, 138, 0.16);
    box-shadow: none;
  }
  .hcard h3 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--cream-on-dark);
  }
  .hcard p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-on-dark);
  }

  /* timeline */
  .htrack {
    position: absolute;
    top: 39px;
    left: 40px;
    width: calc(75% + 13.5px);
    height: 2px;
    border-radius: 2px;
    background: rgba(240, 215, 138, 0.16);
  }
  .hfill {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    transform-origin: left;
    background: linear-gradient(90deg, var(--sage), var(--gold-light));
  }
  :global(html.js) .hfill {
    transform: scaleX(0);
  }
  .hmark {
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: var(--gold-light);
    box-shadow:
      0 0 0 6px rgba(240, 215, 138, 0.18),
      0 0 22px rgba(240, 215, 138, 0.7);
    opacity: 0;
  }
  .hnode {
    position: relative;
    z-index: 1;
    width: 24px;
    height: 24px;
    border-radius: var(--r-pill);
    border: 2px solid var(--gold-soft);
    background: #16392a;
    display: block;
  }
  .htime {
    align-self: flex-start;
    font-size: 14px;
    color: var(--gold-light);
    padding: 3px 10px;
    margin-left: -10px;
    border-radius: var(--r-pill);
  }
  .play .hfill {
    animation: hfill 2700ms linear 300ms both;
  }
  .play .hmark {
    animation: hmark 2700ms linear 300ms both;
  }
  .play .hnode {
    animation: hnodeG 480ms var(--ease-spring) var(--d) both;
  }
  .play .hcard {
    animation: hcardG 600ms var(--ease-out) var(--d) both;
  }
  .play .hcard .htime {
    animation: htimeG 400ms var(--ease-out) var(--d) both;
  }
  @keyframes hfill {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes hmark {
    0% {
      left: 0;
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    94% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  @keyframes hnodeG {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.4);
    }
    100% {
      transform: none;
      background: var(--gold-light);
      box-shadow:
        0 0 0 6px rgba(240, 215, 138, 0.16),
        0 0 20px rgba(240, 215, 138, 0.45);
    }
  }
  @keyframes hcardG {
    to {
      border-color: rgba(240, 215, 138, 0.5);
      background: rgba(255, 253, 245, 0.08);
    }
  }
  @keyframes htimeG {
    to {
      background: rgba(240, 215, 138, 0.16);
      font-weight: 700;
    }
  }

  @media (max-width: 1023px) {
    .head {
      margin-bottom: 44px;
    }
    ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .htrack {
      display: none;
    }
  }
  /* Mobile: vertical timeline. src/scripts/sequences.ts measures --track-len and per-card --d. */
  @media (max-width: 767px) {
    .head {
      margin-bottom: 36px;
    }
    ol {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .hcard {
      padding: 24px 24px 24px 64px;
    }
    .hnode {
      position: absolute;
      left: 22px;
      top: 26px;
    }
    .htrack {
      display: block;
      top: 38px;
      left: 33px;
      width: 2px;
      height: var(--track-len, calc(100% - 76px));
    }
    .hfill {
      transform-origin: top;
      background: linear-gradient(180deg, var(--sage), var(--gold-light));
    }
    :global(html.js) .hfill {
      transform: scaleY(0);
    }
    .hmark {
      top: 0;
      left: 50%;
      margin: -7px 0 0 -7px;
    }
    .play .hfill {
      animation-name: hfillV;
    }
    .play .hmark {
      animation-name: hmarkV;
    }
  }
  @keyframes hfillV {
    to {
      transform: scaleY(1);
    }
  }
  @keyframes hmarkV {
    0% {
      top: 0;
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    94% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hfill,
    .hfill {
      transform: none;
    }
    .hmark {
      display: none;
    }
    .hnode,
    .play .hnode {
      animation: none;
      background: var(--gold-light);
    }
    .play .hcard,
    .play .hcard .htime {
      animation: none;
    }
    .htime {
      background: rgba(240, 215, 138, 0.16);
      font-weight: 700;
    }
  }
</style>
