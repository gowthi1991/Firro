---
import { feed } from '../content/site';
---

<div class="band">
  <div class="container inner">
    <span class="micro label">
      <span class="live-dot live"></span>
      {feed.label}
    </span>
    <span class="divider" aria-hidden="true"></span>
    <span class="feed" aria-live="off">
      {feed.items.map((it, i) => (
        <span style={`animation-delay:${i * 3}s`}>
          <span class="mono time">{it.time}</span>
          <b>{it.event}</b>
          <span class="detail">
            {'  →  '}
            {it.detail}
          </span>
        </span>
      ))}
    </span>
    <span class="sample kitchen">{feed.sample}</span>
  </div>
</div>

<style>
  .band {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(244, 239, 227, 0.75);
    padding: 18px var(--gutter);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 15px;
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--heritage);
    flex: none;
  }
  .divider {
    width: 1px;
    height: 20px;
    background: var(--line);
    flex: none;
  }
  .feed {
    display: inline-grid;
  }
  .feed > span {
    grid-area: 1 / 1;
    opacity: 0;
    animation: feed 15s var(--ease-out) infinite both;
    white-space: nowrap;
  }
  @keyframes feed {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    3% {
      opacity: 1;
      transform: none;
    }
    18% {
      opacity: 1;
      transform: none;
    }
    21% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
  .time {
    color: var(--heritage);
    margin-right: 14px;
  }
  b {
    font-weight: 800;
    color: var(--ink);
  }
  .detail {
    color: var(--muted);
  }
  .kitchen {
    margin-left: auto;
    flex: none;
  }

  @media (max-width: 767px) {
    .band {
      padding: 16px var(--gutter);
    }
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .divider,
    .kitchen {
      display: none;
    }
    .feed {
      width: 100%;
    }
    .feed > span {
      white-space: normal;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feed > span {
      animation: none;
    }
    .feed > span:first-child {
      opacity: 1;
    }
  }
</style>
