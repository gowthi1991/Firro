---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LiveFeed from '../components/LiveFeed.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Batch from '../components/Batch.astro';
import Nutrition from '../components/Nutrition.astro';
import Platform from '../components/Platform.astro';
import Pilot from '../components/Pilot.astro';
import Faq from '../components/Faq.astro';
import Demo from '../components/Demo.astro';
import { faq } from '../content/site';
import { COMPANY, SEO, SITE_URL, SOCIAL, CONTACT } from '../config/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: COMPANY.legalName,
    brand: { '@type': 'Brand', name: COMPANY.brand },
    url: SITE_URL,
    logo: `${SITE_URL}/icon-512.png`,
    email: CONTACT.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: COMPANY.locality,
      addressRegion: COMPANY.region,
      addressCountry: COMPANY.country,
    },
    ...(SOCIAL.length ? { sameAs: SOCIAL } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: COMPANY.brand,
    url: SITE_URL,
    description: SEO.description,
    inLanguage: 'en-IN',
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((it) => ({
      '@type': 'Question',
      name: it.q,
      acceptedAnswer: { '@type': 'Answer', text: it.a },
    })),
  },
];
---

<Base anchorBase="" jsonLd={jsonLd}>
  <Hero />
  <LiveFeed />
  <Problem />
  <HowItWorks />
  <Batch />
  <Nutrition />
  <Platform />
  <Pilot />
  <Faq />
  <Demo />
</Base>
